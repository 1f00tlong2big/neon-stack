; Engine configuration file.
config_version=5

[application]
config/name="Neon Stack"
config/description="Guideline-style marathon with neon arcade look. Drop your own music in Settings."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]
InputBinds="*res://scripts/autoload/input_binds.gd"
SettingsStore="*res://scripts/autoload/settings_store.gd"
HighScores="*res://scripts/autoload/high_scores.gd"
Sfx="*res://scripts/autoload/sfx.gd"
MusicLibrary="*res://scripts/autoload/music_library.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.05, 1)
viewport/hdr_2d=true
